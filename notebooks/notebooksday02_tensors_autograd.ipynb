## 1. Broadcasting Rules & The Silent Bug

import torch

# 1. The Right-to-Left Rule
# PREDICTION: [4, 3, 6]
a = torch.empty(4, 1, 6)
b = torch.empty(3, 1)
c = a + b
print("Success shape:", c.shape)
# ACTUAL: torch.Size([4, 3, 6])
# NOTE: PyTorch aligns dimensions strictly on the right. 1s stretch to match the larger dimension.

# 2. The Error Trap
# PREDICTION: RuntimeError
a = torch.empty(4, 3)
b = torch.empty(4)
try:
    c = a + b
except RuntimeError as e:
    print("\nError Trap:", e)
# ACTUAL: RuntimeError: The size of tensor a (3) must match the size of tensor b (4) at non-singleton dimension 1
# NOTE: The right-most dimensions (3 and 4) do not match, and neither is 1. Left-alignment does not exist.

# 3. The Silent Bug
# PREDICTION: 3x3 Matrix of booleans
a = torch.tensor([1, 2, 3])
b = torch.tensor([1, 2, 3]).view(3, 1)
c = a == b
print("\nSilent Bug Shape:", c.shape)
print("Silent Bug Output:\n", c)
# ACTUAL: torch.Size([3, 3]) and a grid of True/False
# NOTE: (3,) and (3, 1) broadcast into (3, 3). If these are targets and predictions in a loss function, it computes loss over 9 elements instead of 3 without throwing an error.



## 2. Memory Strides and Contiguity (.view vs .reshape)

x = torch.tensor([[1, 2, 3], 
                  [4, 5, 6]])
print("Original strides:", x.stride()) # (3, 1) - 3 steps to next row, 1 step to next col

y = x.transpose(0, 1)
print("Transposed strides:", y.stride()) # (1, 3) - Strides swapped. Memory didn't move.
print("Is y contiguous?", y.is_contiguous())

try:
    y.view(-1)
except RuntimeError as e:
    print("\nView Error:", e)

# The Fix
y_fixed = y.reshape(-1) # or y.contiguous().view(-1)
print("Reshaped shape:", y_fixed.shape)

# NOTE: .transpose() is O(1) and only changes stride metadata. .view() demands contiguous memory. .reshape() safely copies the tensor to a new memory block if necessary.


## 3. Batched Matmul Shapes

# 1. Standard Batched Matmul (e.g., MLP forward pass)
batch = 32
seq_len = 128
dim_in = 768
dim_out = 256

x = torch.randn(batch, seq_len, dim_in)
W = torch.randn(dim_in, dim_out)

out = x @ W
print("MLP Output Shape:", out.shape)
# NOTE: Batch dims are preserved. (128, 768) @ (768, 256) -> (128, 256).

# 2. Attention Matrix Math (Q @ K^T)
head_dim = 64
Q = torch.randn(batch, seq_len, head_dim)
K = torch.randn(batch, seq_len, head_dim)

K_T = K.transpose(-2, -1)
scores = Q @ K_T
print("Attention Scores Shape:", scores.shape)
# NOTE: (32, 128, 64) @ (32, 64, 128) -> (32, 128, 128). Every token computes an attention score with every other token.


## 4. Autograd & Chain Rule

# 1. The Power Rule
a = torch.tensor([2.0, 3.0], requires_grad=True)
b = torch.tensor([6.0, 4.0], requires_grad=True)

Q = 3 * a**3 - b**2
Q.sum().backward()
print("a.grad:", a.grad)
# NOTE: dQ/da = 9a^2. For a=2, grad=36. For a=3, grad=81.

# 2. Gradient Accumulation
w = torch.tensor([1.0], requires_grad=True)
x = torch.tensor([2.0])

(w * x).backward() # First pass adds 2.0 to w.grad
(w * x).backward() # Second pass adds 2.0 to w.grad
print("\nw.grad after two backwards:", w.grad)
# NOTE: PyTorch accumulates (adds) gradients. You MUST call optimizer.zero_grad() in your training loop.

# 3. Neuron Chain Rule ( y = tanh(w*x + b) )
w = torch.tensor([2.0], requires_grad=True)
b = torch.tensor([-2.0], requires_grad=True)
x = torch.tensor([1.0])

z = w * x + b
y = torch.tanh(z)
y.backward()
print("\nNeuron w.grad:", w.grad)
print("Neuron b.grad:", b.grad)
# NOTE: z = 0. dy/dz = 1 - tanh^2(0) = 1. dz/db = 1. Therefore, dy/db = 1 * 1 = 1.0.


## 5. torch.no_grad() Memory Leak Test

# Conceptual demonstration
print("When requires_grad=True, PyTorch builds a Computation Graph behind the scenes.")
print("If you do not use `with torch.no_grad():` during inference, saving predictions to a list will store the entire graph in GPU memory, causing a catastrophic OOM crash.")

# The right way to do inference:
W = torch.randn(100, 100, requires_grad=True)
x = torch.randn(100, 100)

with torch.no_grad():
    y = W @ x
    print("\ny requires_grad during inference:", y.requires_grad)
    
    
